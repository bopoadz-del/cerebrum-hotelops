# Mirror of repo-root .env.example for deploy/env layouts.
# See ../.env.example and deploy/secrets_guide.md.
HOTELOPS_ENV=pilot
HOTELOPS_MARKET=uae
HOTELOPS_HOST=0.0.0.0
HOTELOPS_PORT=43180
HOTELOPS_FIXTURE_MODE=1
# Required — no code defaults. API refuses to start if unset/empty.
HOTELOPS_OPERATOR_TOKEN=operator-pilot
HOTELOPS_REVIEWER_TOKEN=reviewer-pilot
# HOTELOPS_CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
DATABASE_URL=postgresql+psycopg://hotelops:hotelops@postgres:5432/hotelops
REDIS_URL=redis://redis:6379/0
HOTELOPS_LLM_PROVIDER=fake
VITE_API_BASE=http://127.0.0.1:43180
