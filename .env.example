# cerebrum-hotelops — copy to .env. No live secrets belong in this file.

# Runtime
HOTELOPS_ENV=pilot
HOTELOPS_MARKET=uae
HOTELOPS_HOST=0.0.0.0
HOTELOPS_PORT=43180
HOTELOPS_LOG_LEVEL=info
HOTELOPS_FIXTURE_MODE=1

# Auth — required. No code defaults; the API refuses to start if either is empty.
# Set explicitly for local/CI (examples below). Rotate before any live pilot.
HOTELOPS_OPERATOR_TOKEN=operator-pilot
HOTELOPS_REVIEWER_TOKEN=reviewer-pilot

# Browser CORS allowlist (comma-separated). Never "*". Bearer API, credentials off.
# Local Vite defaults if unset: http://127.0.0.1:43123,http://localhost:43123
# HOTELOPS_CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123

# Postgres + pgvector (docker-compose defaults)
DATABASE_URL=postgresql+psycopg://hotelops:hotelops@localhost:55432/hotelops

# Redis event/work queue
REDIS_URL=redis://localhost:56379/0

# LLM — default is the deterministic fake provider (CI-safe).
# Set HOTELOPS_LLM_PROVIDER=kimi|azure only when the matching secrets exist.
HOTELOPS_LLM_PROVIDER=fake
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# Live connectors — leave unset to stay on fixtures/connectors/*.
# OPERA_BASE_URL=
# OPERA_CLIENT_ID=
# OPERA_CLIENT_SECRET=
# MICROS_BASE_URL=
# MICROS_API_KEY=
# LOYALTY_LMS_BASE_URL=
# LOYALTY_LMS_API_KEY=
# GRMS_BASE_URL=
# GRMS_API_KEY=
# MAXIMO_BASE_URL=
# MAXIMO_API_KEY=
# GAMING_CMS_BASE_URL=
# GAMING_CMS_API_KEY=

# Vision edge / Jetson — optional hardware gate
# JETSON_GATEWAY_URL=
# JETSON_DEVICE_TOKEN=

# Frontend
VITE_API_BASE=http://127.0.0.1:43180
